<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 en nieuwer: dezelfde regel, voor de back-up en voor overzetten. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
